# =============================================
# Proe — Environment Variables
# =============================================
# Copy this file to .env.local and fill in real values

# Convex
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOY_KEY=your-deploy-key

# App URL (for email verification links)
NEXTAUTH_URL=https://yourdomain.com

# Email (Resend)
RESEND_API_KEY=re_xxxxx

# Payments (Paystack)
PAYSTACK_SECRET_KEY=sk_xxxxx
PAYSTACK_CURRENCY=ZAR
PAYSTACK_PREMIUM_PLAN_CODE=PROE_PREMIUM

# PUDO (South African Locker Network — generic/mock API)
PUDO_API_KEY=your-pudo-api-key
PUDO_API_SECRET=your-pudo-api-secret
