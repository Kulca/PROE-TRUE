# =============================================
# Proe — Environment Variables
# =============================================
# Copy this file to .env.local and fill in real values

# NextAuth.js (Social SSO)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Facebook OAuth
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret

# Apple OAuth
APPLE_CLIENT_ID=your-apple-team-id.your-bundle-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----"

# PayU (South Africa Payment Gateway)
PAYU_MERCHANT_KEY=your-payu-merchant-key
PAYU_MERCHANT_SECRET=your-payu-merchant-secret
PAYU_SAFE_KEY=your-payu-safekey
# Webhook URL (configure in PayU dashboard): https://yourdomain.com/api/webhooks/payu

# Convex
CONVEX_DEPLOYMENT=your-convex-deployment-url
CONVEX_DEPLOY_KEY=your-convex-deploy-key

# PUDO (South African Locker Network — generic/mock API)
PUDO_API_KEY=your-pudo-api-key
PUDO_API_SECRET=your-pudo-api-secret
